# Copy to .env and fill in real values (backend/.env is gitignored).
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/cybersentinel
JWT_SECRET=change-me-generate-with-node-crypto-randomBytes-64
JWT_REFRESH_SECRET=change-me-generate-with-node-crypto-randomBytes-64
JWT_EXPIRES_IN=1h
TOKEN_COOKIE_NAME=cybersentinel-token
